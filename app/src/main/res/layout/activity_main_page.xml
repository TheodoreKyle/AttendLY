<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#026D83"
    android:orientation="vertical"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#001824"
        android:paddingTop="45dp"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp"
        android:orientation="horizontal"
        >

        <TextView
            android:id="@+id/tvGreetings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi, Username!"

            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/jersey10"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            >
        </TextView>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:srcCompat="@drawable/attendly"
            android:clickable="true"
            android:focusable="true"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="vertical"
        android:layout_weight="1"
        >

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginTop="16dp"
            >


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="#265A71"
                android:padding="8dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edittext_box"
                    android:fontFamily="@font/jersey10"

                    android:hint="Search Events"
                    android:textColorHint="#204150"
                    android:textSize="32sp">

                </EditText>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            android:layout_marginTop="24dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="700dp"
                android:orientation="vertical"
                android:background="#265A71"
                android:padding="16dp">

                <!--this is an item-->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E1E1E"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            >

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Event Name"

                                android:textColor="#FFFFFF"
                                android:fontFamily="@font/jersey10"
                                android:textSize="48sp"
                                android:layout_weight="1"
                                >
                            </TextView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0/1000"

                                android:textColor="#C7C589"
                                android:fontFamily="@font/jersey10"
                                android:textSize="48sp"
                                >
                            </TextView>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Category: Sample"

                                android:textSize="24sp"
                                android:textColor="#E35E60"
                                android:fontFamily="@font/jersey10"
                                android:layout_weight="1"
                                >
                            </TextView>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date &amp; Time: Nov 20, 2026 | 3PM - 5PM"

                                android:textSize="16sp"
                                android:textColor="#B089C7"
                                android:fontFamily="@font/jersey10"
                                >
                            </TextView>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>


            </LinearLayout>



        </androidx.cardview.widget.CardView>


    </LinearLayout>


    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="16dp"
            >



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#001824"
                    android:padding="16dp"
                    android:orientation="horizontal"
                    >

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Events"

                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jersey10"

                        android:backgroundTint="#265A71"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        >
                    </Button>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Created"

                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jersey10"

                        android:backgroundTint="#265A71"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        >
                    </Button>

                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Joined"

                        android:textSize="28sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/jersey10"

                        android:backgroundTint="#265A71"
                        android:layout_weight="1"
                        >
                    </Button>
                </LinearLayout>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="top|center_horizontal"
            android:elevation="10dp"
            app:srcCompat="@drawable/attendly" />
    </FrameLayout>

</LinearLayout>