<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#001824"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="38dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/tvGreetings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/jersey10"
            android:text="Hi, Username!"
            android:textColor="#FFFFFF"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:contentDescription="Profile"
            android:focusable="true"
            app:srcCompat="@drawable/attendly" />

    </LinearLayout>

    <!-- Scrollable Body (prevents cutoff on smaller screens) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/Back"
                    android:layout_width="76dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/description_box"
                    android:contentDescription="Back"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/back_arrow" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="68dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/glass_container"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="176dp"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="2dp">

                            <ImageView
                                android:id="@+id/ivEventBanner"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="Event Banner"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/fillerimg" />

                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/tvEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/jersey10"
                            android:text="Theo's Event"
                            android:textColor="#FFFFFF"
                            android:textSize="35sp" />

                        <!-- Category & Date/Time Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/pill_green"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:padding="3dp"
                                    app:srcCompat="@drawable/bgcategory" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/jersey10"
                                    android:text="Category: "
                                    android:textColor="#A8E6CF"
                                    android:textSize="17sp" />

                                <TextView
                                    android:id="@+id/tvCategory"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/jersey10"
                                    android:maxLines="1"
                                    android:text="Gaming"
                                    android:textColor="#FFFFFF"
                                    android:textSize="17sp" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_weight="1"
                                android:background="@drawable/pill_red"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="6dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:padding="3dp"
                                    app:srcCompat="@drawable/clock" />

                                <TextView
                                    android:id="@+id/tvDateTime"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/jersey10"
                                    android:maxLines="1"
                                    android:text="November 6, 2026, 2pm-4pm"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Location Pill -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/pill_blue"
                            android:gravity="center_vertical"
                            android:minHeight="36dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="6dp">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:padding="3dp"
                                app:srcCompat="@drawable/location" />

                            <TextView
                                android:id="@+id/tvLocation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/jersey10"
                                android:text="1815 Frassati Building"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp" />

                        </LinearLayout>

                        <!-- Description Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="145dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/description_box"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/jersey10"
                                android:text="Description:"
                                android:textColor="#B0C4DE"
                                android:textSize="18sp" />

                            <androidx.core.widget.NestedScrollView
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_marginTop="4dp"
                                android:layout_weight="1">

                                <TextView
                                    android:id="@+id/tvEventDescription"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jersey10"
                                    android:lineSpacingExtra="2dp"
                                    android:text="Description djawpodjawodjawopdnaowdoawndoawdjadjawjdawjdoawdaw"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp" />

                            </androidx.core.widget.NestedScrollView>

                        </LinearLayout>

                        <!-- Capacity & Join Footer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCapacity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bgcapacity"
                                android:fontFamily="@font/jersey10"
                                android:paddingHorizontal="18dp"
                                android:paddingVertical="8dp"
                                android:text="Capacity: 8/20"
                                android:textColor="#FFFFFF"
                                android:textSize="20sp" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnJoin"
                                android:layout_width="136dp"
                                android:layout_height="44dp"
                                android:background="@drawable/description_box"
                                android:fontFamily="@font/jersey10"
                                android:gravity="center"
                                android:padding="0dp"
                                android:text="Join"
                                android:textAllCaps="false"
                                android:textColor="#B8CEDB"
                                android:textSize="26sp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/ivCardMascot"
                    android:layout_width="100dp"
                    android:layout_height="96dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="6dp"
                    android:elevation="10dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/attendlymasc2" />

            </FrameLayout>

            <!-- Bottom Centered Logo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivBottomMascot"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/attendly" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>