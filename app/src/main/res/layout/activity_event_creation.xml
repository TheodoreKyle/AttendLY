<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#026D83"
    android:orientation="vertical" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#001824"
        android:padding="24dp"
        android:orientation="horizontal" >

        <TextView
            android:id="@+id/tvGreetings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi, Username!"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:fontFamily="@font/jersey10"
            android:layout_weight="1"
            android:layout_marginTop="10dp" >
        </TextView>

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="50dp"
            android:layout_height="50dp"
            app:srcCompat="@drawable/attendly"
            android:clickable="true"
            android:focusable="true"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cvBackButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#265A71"
                app:contentPaddingLeft="18dp"
                app:contentPaddingRight="18dp"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivBackIcon"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    app:srcCompat="@drawable/backicon" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/ivAttendlyLogoCenter"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/attendly" />
        </RelativeLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            android:layout_marginTop="24dp" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#265A71"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cvUploadImage"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#265A71"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivAddIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:srcCompat="@drawable/addicon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/jersey10"
                            android:text="Upload Image"
                            android:textColor="#819BA6"
                            android:textSize="36sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="3dp"
                    android:layout_marginTop="24dp" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#1E1E1E"
                        android:padding="20dp" >

                        <!-- Event Name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Event name:"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etEventName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="Enter Event name"
                            android:inputType="textCapSentences"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                        <!-- Category -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Category:"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="eg. Gaming, Meeting, Study ..."
                            android:inputType="textCapSentences"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Date &amp; Time"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etDateTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="Month d, YYYY | 00:00 - 00:00"
                            android:clickable="true"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:cursorVisible="false"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Location:"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="Enter Location"
                            android:inputType="textCapSentences"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Capacity:"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etCapacity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="Must be a valid number"
                            android:inputType="number"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Description:"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <EditText
                            android:id="@+id/etDescription"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/edittext_box"
                            android:fontFamily="@font/jersey10"
                            android:hint="This event is about... please bring...."
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="1000"
                            android:padding="10dp"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#4A6B7C"
                            android:textSize="20sp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/ivBottomMascot"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentBottom="false"
                        android:layout_marginStart="-10dp"
                        android:scaleType="fitBottom"
                        app:srcCompat="@drawable/iconquestion" />

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvPublishButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="#1A513D"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="32dp"
                            android:paddingVertical="12dp"
                            android:fontFamily="@font/jersey10"
                            android:text="Publish"
                            android:textColor="#FFFFFF"
                            android:textSize="36sp" />

                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>