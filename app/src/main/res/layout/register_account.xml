<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="45dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="135dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1E1E1E"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:fontFamily="@font/jersey10"
                        android:gravity="center"
                        android:text="Create Account"
                        android:textColor="#FFFFFF"
                        android:textSize="48sp" />

                    <!-- Full Name -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/jersey10"
                        android:text="Full Name:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edittext_box"
                        android:fontFamily="@font/jersey10"
                        android:hint="Enter full name"
                        android:inputType="textPersonName|textCapWords"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A6B7C"
                        android:textSize="22sp" />

                    <!-- Username -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey10"
                        android:text="Username:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etUsername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edittext_box"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                        android:fontFamily="@font/jersey10"
                        android:hint="Letters and numbers only"
                        android:inputType="textNoSuggestions"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A6B7C"
                        android:textSize="22sp" />

                    <!-- Age -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey10"
                        android:text="Age:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edittext_box"
                        android:fontFamily="@font/jersey10"
                        android:hint="Enter age"
                        android:inputType="number"
                        android:maxLength="3"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A6B7C"
                        android:textSize="22sp" />

                    <!-- Gender -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey10"
                        android:text="Gender:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <Spinner
                        android:id="@+id/spGender"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edittext_box"
                        android:entries="@array/gender_options"
                        android:popupBackground="#1E1E1E" />

                    <!-- Email -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey10"
                        android:text="Email:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edittext_box"
                        android:fontFamily="@font/jersey10"
                        android:hint="Enter email"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A6B7C"
                        android:textSize="22sp" />

                    <!-- Password -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jersey10"
                        android:text="Password:"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp" />

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/edittext_box"
                        android:fontFamily="@font/jersey10"
                        android:hint="Password must be at least 6 characters"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#4A6B7C"
                        android:textSize="22sp" />

                    <!-- Already have an account -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="32dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/jersey10"
                            android:text="Already have an account?"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/btnLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/jersey10"
                            android:text="Login"
                            android:textColor="#0076A8"
                            android:textSize="20sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="top|center_horizontal"
                app:srcCompat="@drawable/attendlymasc2" />

        </FrameLayout>

        <Button
            android:id="@+id/createAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:backgroundTint="#56819BA6"
            android:fontFamily="@font/jersey10"
            android:text="Create"
            android:textColor="#FFFFFF"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivBottomImage"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginBottom="24dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/attendly" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>