<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfilePage"
    android:orientation="vertical"
    android:background="@drawable/bg"
    android:padding="24dp"
    android:layout_gravity="center" >

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        android:fontFamily="@font/jersey10"
        android:textSize="32sp"
        android:backgroundTint="#4A6B7C"
        android:layout_marginVertical="8dp" >
    </Button>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false" >

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        android:layout_marginTop="110dp" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="32dp" >

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:clickable="true"
                android:focusable="true"
                app:srcCompat="@drawable/attendly" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginVertical="16dp"
                android:fontFamily="@font/jersey10"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="48sp" >

            </TextView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey10"
                    android:text="Full Name: "
                    android:textColor="#FFFFFF"
                    android:textSize="28sp">

                </TextView>

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jersey10"
                    android:hint="Current Name"
                    android:textColorHint="#4A6B7C"
                    android:textSize="24sp">
                </EditText>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey10"
                    android:text="Userame: "
                    android:textColor="#FFFFFF"
                    android:textSize="28sp">
                </TextView>

                <EditText
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jersey10"
                    android:hint="Current Name"
                    android:textColorHint="#4A6B7C"
                    android:textSize="24sp">
                </EditText>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey10"
                    android:text="Age: "
                    android:textColor="#FFFFFF"
                    android:textSize="28sp" >
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jersey10"
                    android:text="20"
                    android:textColor="#4A6B7C"
                    android:textSize="24sp" >
                </TextView>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey10"
                    android:text="Gender: "
                    android:textColor="#FFFFFF"
                    android:textSize="28sp">
                </TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jersey10"
                    android:text="Male/Female"
                    android:textColor="#4A6B7C"
                    android:textSize="24sp">
                </TextView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jersey10"

                    android:text="Account: "
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"></TextView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/jersey10"

                    android:text="Regular/Admin"
                    android:textColor="#4A6B7C"
                    android:textSize="24sp"></TextView>
            </LinearLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"

                android:layout_marginVertical="20dp"
                android:backgroundTint="#4A6B7C"
                android:fontFamily="@font/jersey10"
                android:text="Save Changes"
                android:textSize="32sp"
                android:textColor="#FFFFFF">

            </Button>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivNavMascot"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="top|end"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/attendlymasc3"
            />
    </FrameLayout>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:fontFamily="@font/jersey10"
        android:textSize="40sp"
        android:backgroundTint="#4A6B7C"
        android:layout_marginVertical="20dp"
        android:layout_gravity="center"
        android:textColor="#FFFFFF">
    </Button>

</LinearLayout>